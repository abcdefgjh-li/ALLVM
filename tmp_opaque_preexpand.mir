--- |
  ; ModuleID = 'D:\cpp\ALLVM\llvm\test\CodeGen\AArch64\irobf-opaque-predicate-bytes.ll'
  source_filename = "D:\\cpp\\ALLVM\\llvm\\test\\CodeGen\\AArch64\\irobf-opaque-predicate-bytes.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64-unknown-linux-gnu"
  
  define i32 @opaque_bytes(i32 %x) local_unnamed_addr {
    %add = add nsw i32 %x, 1
    ret i32 %add
  }
...
