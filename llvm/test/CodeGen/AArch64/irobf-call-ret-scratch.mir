# RUN: llc -mtriple=aarch64-none-linux-gnu -run-pass=aarch64-call-ret-obfuscation -aarch64-obfuscate-call-ret -verify-machineinstrs=0 -o - %s | FileCheck %s

--- |
  define void @keep_x16_live() {
    ret void
  }

  declare void @callee()
...
---
name: keep_x16_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $lr, $x16

    ; CHECK-LABEL: name: keep_x16_live
    ; CHECK: bb.0:
    ; CHECK: liveins: $lr, $x16
    ; CHECK-NOT: {{$}}x16 = ADRP
    ; CHECK-NOT: {{$}}x16 = ADDXri
    ; CHECK: ADRP
    ; CHECK: ADDXri
    ; CHECK-NOT: BLR {{$}}x16
    ; CHECK: BLR
    ; CHECK: implicit $x16
    $x17 = ADRP target-flags(aarch64-page) @callee
    $x17 = ADDXri $x17, target-flags(aarch64-pageoff, aarch64-nc) @callee, 0
    BLR $x17, implicit $x16, implicit-def dead $lr, implicit $sp, implicit-def $sp
    RET_ReallyLR
...
