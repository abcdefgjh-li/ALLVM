# RUN: llc -mtriple=aarch64-linux-gnu -run-pass=aarch64-opaque-predicate-obfuscation -aarch64-obfuscate-opaque-predicate -o - %s | FileCheck %s

--- |
  define i32 @opaque_entry(i32 %x) {
    %add = add nsw i32 %x, 1
    ret i32 %add
  }
...
---
name: opaque_entry
alignment: 4
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0

    ; CHECK-LABEL: name: opaque_entry
    ; CHECK: bb.0:
    ; CHECK: liveins: $w0
    ; CHECK: $x9 = ADDXri $xzr, 0, 0
    ; CHECK-NEXT: CBNZX killed $x9, %bb.1
    ; CHECK-NEXT: B %bb.2
    ; CHECK: bb.1:
    ; CHECK-NEXT: successors: %bb.2
    ; CHECK-NEXT: HINT 127
    ; CHECK: bb.2:
    ; CHECK: renamable $w8 = BUNDLE $w0
    ; CHECK: renamable $w8 = nsw ADDWri killed renamable $w8, 1, 0
    ; CHECK: $w0 = BUNDLE killed renamable $w8
    ; CHECK: RET_ReallyLR implicit $w0
    renamable $w8 = BUNDLE $w0
    renamable $w8 = nsw ADDWri killed renamable $w8, 1, 0
    $w0 = BUNDLE killed renamable $w8
    RET_ReallyLR implicit $w0
...
