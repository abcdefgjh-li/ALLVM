QMAKE_PRL_TARGET = Qt6OpcUa.lib
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.10.2
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/Qt6Network.lib $$[QT_INSTALL_LIBS]/Qt6Core.lib $$[QT_INSTALL_LIBS]/Qt6BundledZLIB.lib -lsynchronization -lmpr -luserenv -lauthz -lkernel32 -lnetapi32 -lntdll -lole32 -lruntimeobject -lshell32 -luser32 -luuid -lversion -lwinmm -licuuc -licuin $$[QT_INSTALL_LIBS]/Qt6BundledPcre2.lib -ladvapi32 -ldnsapi -liphlpapi -lsecur32 -lwinhttp -L"C:/Program Files/OpenSSL/lib/VC/x64/MD" -llibssl -llibcrypto -lws2_32 -lcrypt32
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/Qt6Network.lib;$$[QT_INSTALL_LIBS]/Qt6Core.lib;$$[QT_INSTALL_LIBS]/Qt6BundledZLIB.lib;-lsynchronization;-lmpr;-luserenv;-lauthz;-lkernel32;-lnetapi32;-lntdll;-lole32;-lruntimeobject;-lshell32;-luser32;-luuid;-lversion;-lwinmm;-licuuc;-licuin;$$[QT_INSTALL_LIBS]/Qt6BundledPcre2.lib;-ladvapi32;-ldnsapi;-liphlpapi;-lsecur32;-lwinhttp;-L"C:/Program Files/OpenSSL/lib/VC/x64/MD";-llibssl;-llibcrypto;-lws2_32;-lcrypt32
