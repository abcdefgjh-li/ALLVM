QMAKE_PRL_TARGET = Qt6DBus.lib
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.10.2
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/Qt6Core.lib $$[QT_INSTALL_LIBS]/Qt6BundledZLIB.lib -lsynchronization -lmpr -luserenv -lauthz -lkernel32 -lntdll -lole32 -lruntimeobject -lshell32 -luuid -lversion -lwinmm -licuuc -licuin $$[QT_INSTALL_LIBS]/Qt6BundledPcre2.lib -ladvapi32 -lnetapi32 -luser32 -lws2_32
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/Qt6Core.lib;$$[QT_INSTALL_LIBS]/Qt6BundledZLIB.lib;-lsynchronization;-lmpr;-luserenv;-lauthz;-lkernel32;-lntdll;-lole32;-lruntimeobject;-lshell32;-luuid;-lversion;-lwinmm;-licuuc;-licuin;$$[QT_INSTALL_LIBS]/Qt6BundledPcre2.lib;-ladvapi32;-lnetapi32;-luser32;-lws2_32
