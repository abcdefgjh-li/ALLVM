QMAKE_PRL_TARGET = qjpeg.lib
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.10.2
QMAKE_PRL_LIBS = $$[QT_INSTALL_PREFIX]/lib/objects-Release/Gui_resources_1/.qt/rcc/qrc_qpdf_init.cpp.obj $$[QT_INSTALL_PREFIX]/lib/objects-Release/Gui_resources_2/.qt/rcc/qrc_gui_shaders_init.cpp.obj $$[QT_INSTALL_PLUGINS]/imageformats/qjpeg.lib $$[QT_INSTALL_LIBS]/Qt6Gui.lib -ld3d11 -ldxgi -ldxguid -ld3d12 -lgdi32 -luxtheme $$[QT_INSTALL_LIBS]/Qt6BundledHarfbuzz.lib $$[QT_INSTALL_LIBS]/Qt6BundledFreetype.lib $$[QT_INSTALL_LIBS]/Qt6BundledLibpng.lib -ld2d1 -ldwrite $$[QT_INSTALL_LIBS]/Qt6Core.lib $$[QT_INSTALL_LIBS]/Qt6BundledZLIB.lib -lsynchronization -lmpr -luserenv -ladvapi32 -lauthz -lkernel32 -lnetapi32 -lntdll -lole32 -lruntimeobject -lshell32 -luser32 -luuid -lversion -lwinmm -lws2_32 -licuuc -licuin $$[QT_INSTALL_LIBS]/Qt6BundledPcre2.lib $$[QT_INSTALL_LIBS]/Qt6BundledLibjpeg.lib
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_PREFIX]/lib/objects-Release/Gui_resources_1/.qt/rcc/qrc_qpdf_init.cpp.obj;$$[QT_INSTALL_PREFIX]/lib/objects-Release/Gui_resources_2/.qt/rcc/qrc_gui_shaders_init.cpp.obj;$$[QT_INSTALL_PLUGINS]/imageformats/qjpeg.lib;$$[QT_INSTALL_LIBS]/Qt6Gui.lib;-ld3d11;-ldxgi;-ldxguid;-ld3d12;-lgdi32;-luxtheme;$$[QT_INSTALL_LIBS]/Qt6BundledHarfbuzz.lib;$$[QT_INSTALL_LIBS]/Qt6BundledFreetype.lib;$$[QT_INSTALL_LIBS]/Qt6BundledLibpng.lib;-ld2d1;-ldwrite;$$[QT_INSTALL_LIBS]/Qt6Core.lib;$$[QT_INSTALL_LIBS]/Qt6BundledZLIB.lib;-lsynchronization;-lmpr;-luserenv;-ladvapi32;-lauthz;-lkernel32;-lnetapi32;-lntdll;-lole32;-lruntimeobject;-lshell32;-luser32;-luuid;-lversion;-lwinmm;-lws2_32;-licuuc;-licuin;$$[QT_INSTALL_LIBS]/Qt6BundledPcre2.lib;$$[QT_INSTALL_LIBS]/Qt6BundledLibjpeg.lib
